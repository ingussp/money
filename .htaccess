Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(app|database|storage|tools|tests)(/|$) - [F,L,NC]
RewriteRule ^(config(?:\.local|\.example)?\.php|router\.php|create-pr\.cmd|README\.md|.*\.(sql|log|json|ps1|mjs))$ - [F,L,NC]
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
